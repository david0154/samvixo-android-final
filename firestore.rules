rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper: admin check via Firestore (NOT custom claims) ─────────────
    function isAdmin() {
      return request.auth != null &&
        exists(/databases/$(database)/documents/admin_users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admin_users/$(request.auth.uid)).data.role
          in ['admin', 'superadmin', 'super_admin', 'second_admin', 'tech_team', 'support_team'];
    }

    // ── web_sessions: FULLY OPEN — no auth needed for QR ─────────────────
    match /web_sessions/{sessionId} {
      allow read, write: if true;
    }

    // ── users ─────────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
    match /users/{uid}/{subcol}/{docId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // ── chats + messages ──────────────────────────────────────────────────
    match /chats/{chatId} {
      allow read, write: if request.auth != null;
    }
    match /chats/{chatId}/messages/{messageId} {
      allow read, write: if request.auth != null;
    }

    // ── groups ───────────────────────────────────────────────────────────
    // Fixes: group creation permission denied
    match /groups/{groupId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null &&
        resource.data.createdBy == request.auth.uid;
    }
    match /groups/{groupId}/messages/{messageId} {
      allow read, write: if request.auth != null;
    }

    // ── channels ──────────────────────────────────────────────────────────
    // Fixes: channel creation permission denied
    match /channels/{channelId} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null;
      allow delete: if request.auth != null &&
        resource.data.createdBy == request.auth.uid;
    }
    match /channels/{channelId}/posts/{postId} {
      allow read, write: if request.auth != null;
    }
    match /channels/{channelId}/messages/{messageId} {
      allow read, write: if request.auth != null;
    }

    // ── typing ────────────────────────────────────────────────────────────
    match /typing/{chatId} {
      allow read, write: if request.auth != null;
    }

    // ── statuses ──────────────────────────────────────────────────────────
    match /statuses/{statusId} {
      allow read, write: if request.auth != null;
    }

    // ── reports ───────────────────────────────────────────────────────────
    match /reports/{reportId} {
      allow create: if request.auth != null;
      allow read, update, delete: if isAdmin();
    }

    // ── contact_requests ─────────────────────────────────────────────────
    match /contact_requests/{docId} {
      allow create: if request.auth != null;
      allow read, update, delete: if isAdmin();
    }

    // ── inbox_messages ────────────────────────────────────────────────────
    match /inbox_messages/{docId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.recipientUid;
      allow write: if isAdmin();
    }

    // ── call_signals ──────────────────────────────────────────────────────
    match /call_signals/{callId} {
      allow read, write: if request.auth != null;
    }

    // ── admin_users — readable by any logged-in user ──────────────────────
    match /admin_users/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // ── admin_config ──────────────────────────────────────────────────────
    match /admin_config/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // ── app_config ────────────────────────────────────────────────────────
    match /app_config/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // ── audit_logs ────────────────────────────────────────────────────────
    match /audit_logs/{docId} {
      allow read, write: if isAdmin();
    }

    // ── broadcasts ────────────────────────────────────────────────────────
    match /broadcasts/{docId} {
      allow read, write: if isAdmin();
    }

    // ── screenshot_alerts ─────────────────────────────────────────────────
    match /screenshot_alerts/{docId} {
      allow read, write: if request.auth != null;
    }

    // ── official_status ───────────────────────────────────────────────────
    match /official_status/{docId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    // ── scheduled_notifications ───────────────────────────────────────────
    match /scheduled_notifications/{docId} {
      allow read, write: if isAdmin();
    }

    // ── drive_backup_requests ─────────────────────────────────────────────
    match /drive_backup_requests/{docId} {
      allow read, write: if request.auth != null;
    }

    // ── fcm_tokens — store per-user push tokens ───────────────────────────
    match /fcm_tokens/{uid} {
      allow read:  if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

  }
}
// updated: 2026-06-10T12:35:00Z  firestore rules
